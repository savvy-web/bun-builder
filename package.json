			"optional": false
		},
		"@types/bun": {
			"optional": false
		},
		"typescript": {
			"optional": false
		}
	},
	"packageManager": "bun@1.4.0",
	"engines": {
		"bun": ">=1.4.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": "1.4.0",
			"onFail": "ignore"
		},
		"runtime": [
			{
				"name": "bun",
				"version": "1.4.0",
				"onFail": "ignore"
			}
		]
	},
	"publishConfig": {
		"access": "public",
		"directory": "dist/dev",
		"targets": {
			"npm": {
				"directory": "dist/npm"
			},
			"github": {
				"directory": "dist/npm"
			}
		}
