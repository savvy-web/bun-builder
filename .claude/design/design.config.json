{
	"$schema": "../skills/design-config/json-schemas/current.json",
	"integration": {
		"ci": {
			"enabled": false,
			"syncOnMerge": false,
			"validateOnPR": false
		},
		"git": {
			"requireReviewForChanges": false,
			"trackDesignDocs": true
		},
		"plans": {
			"autoSyncProgress": false,
			"bidirectionalLinking": true,
			"cacheMetadata": true,
			"cacheTTL": 300,
			"enabled": true,
			"validateOnCommit": true
		}
	},
	"modules": {
		"bun-builder": {
			"categories": ["architecture", "performance", "testing", "integration", "reference"],
			"designDocsPath": ".claude/design/bun-builder",
			"maintainer": "Spencer Beggs",
			"path": ".",
			"userDocs": {
				"readme": "README.md",
				"repoDocs": null,
				"siteDocs": null
			}
		}
	},
	"paths": {
		"context": "CLAUDE.md",
		"designDocs": ".claude/design",
		"plans": ".claude/plans",
		"skills": ".claude/skills"
	},
	"project": {
		"maintainer": "Spencer Beggs",
		"name": "@savvy-web/bun-builder",
		"repository": "https://github.com/savvy-web/bun-builder",
		"type": "package"
	},
	"quality": {
		"context": {
			"childMaxLines": 300,
			"requireDesignDocPointers": true,
			"rootMaxLines": 500
		},
		"designDocs": {
			"maxLineLength": 120,
			"minSections": ["Overview", "Current State", "Rationale"],
			"requireFrontmatter": true,
			"requireTOC": true
		},
		"plans": {
			"archiveAfterDays": 30,
			"maxLineLength": 120,
			"progressRange": [0, 100],
			"requiredFields": ["name", "title", "created", "status", "progress"],
			"requireFrontmatter": true,
			"stalenessThresholdDays": 30,
			"validStatuses": ["ready", "in-progress", "blocked", "completed", "abandoned"]
		},
		"userDocs": {
			"level1": {
				"maxLineLength": 100,
				"requireSections": ["Features", "Installation", "Usage"],
				"targetWordCount": [200, 500]
			}
		}
	},
	"skills": {
		"baseNamespace": "/",
		"enabled": [
			"design-init",
			"design-validate",
			"design-update",
			"design-review",
			"design-sync",
			"design-search",
			"design-link",
			"design-report",
			"design-audit",
			"design-config"
		]
	},
	"version": "1.0.0"
}
